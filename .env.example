# Copia este ficheiro como ".env" e enche os valores reais.
# NUNCA subir ".env" a git nin compartilo — só vive local e, para a automatización, en GitHub Secrets.

# Instagram API with Instagram Login (Graph API)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Datos da Meta App (developers.facebook.com/apps/<APP_ID>) — precisos para renovar o token
APP_ID=
APP_SECRET=

# FTP para subir os arquivos antes de publicar (ariacedeira.gal/ig/)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/ig/
